let dragState=null;const activePointers=new Map();let pinchStart=null;function getCanvasCoords(e){const r=cv.getBoundingClientRect();return{x:(e.clientX-r.left)*(cv.width/r.width),y:(e.clientY-r.top)*(cv.height/r.height)}}function pointerDistance(a,b){return Math.hypot(a.x-b.x,a.y-b.y)}cv.addEventListener('pointerdown',e=>{if(!photo)return;cv.setPointerCapture(e.pointerId);const p=getCanvasCoords(e);activePointers.set(e.pointerId,p);if(activePointers.size===1&&selected>=0){const so=objects[selected];if(so&&(so.sticker||so.type==='image')){const b=getBounds(so),dx=p.x-so.x,dy=p.y-so.y,ang=-so.rotation*Math.PI/180,lx=dx*Math.cos(ang)-dy*Math.sin(ang),ly=dx*Math.sin(ang)+dy*Math.cos(ang);if(Math.hypot(lx-(b.w/2+10),ly-(-b.h/2-10))<22){snap();objects.splice(selected,1);selected=-1;dragState=null;activePointers.delete(e.pointerId);render();return}}}if(activePointers.size===2&&selected>=0){const pts=[...activePointers.values()],o=objects[selected];pinchStart={distance:pointerDistance(pts[0],pts[1]),scale:o.scale,startSize:o.size||null};dragState=null;return}if(activePointers.size>1)return;let hit=-1;for(let i=objects.length-1;i>=0;i--){const o=objects[i];if(o.hidden)continue;const b=getBounds(o);if(Math.abs(p.x-o.x)<b.w/2+20&&Math.abs(p.y-o.y)<b.h/2+20){hit=i;break}}selected=hit;render();if(selected>=0){snap();const o=objects[selected];dragState={startX:p.x,startY:p.y,objX:o.x,objY:o.y};$('objOpacity').value=o.opacity;$('valOpacity').textContent=o.opacity}});cv.addEventListener('pointermove',e=>{if(!activePointers.has(e.pointerId))return;const p=getCanvasCoords(e);activePointers.set(e.pointerId,p);if(activePointers.size===2&&selected>=0&&pinchStart){const pts=[...activePointers.values()],o=objects[selected],ratio=pointerDistance(pts[0],pts[1])/Math.max(1,pinchStart.distance);o.scale=Math.max(.15,Math.min(8,pinchStart.scale*ratio));if(o.type==='text')$('fontSize').value=Math.round(o.size*o.scale);draw();return}if(!dragState||selected<0)return;const o=objects[selected];o.x=dragState.objX+(p.x-dragState.startX);o.y=dragState.objY+(p.y-dragState.startY);draw()});function endPointer(e){activePointers.delete(e.pointerId);if(activePointers.size<2)pinchStart=null;if(activePointers.size===0)dragState=null}cv.addEventListener('pointerup',endPointer);cv.addEventListener('pointercancel',endPointer);cv.addEventListener('dblclick',()=>{if(selected>=0&&objects[selected]?.type==='text')openTextModal(selected)});
