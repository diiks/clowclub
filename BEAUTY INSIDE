function updateSelectedText(prop,val){const o=objects[selected];if(o&&o.type==='text'){o[prop]=val;draw()}}const fontOptions=Array.from($('fontFamily').options).map(o=>o.value);function chooseFont(step){const o=objects[selected];if(!o||o.type!=='text')return;let i=fontOptions.indexOf(o.font);i=(i+step+fontOptions.length)%fontOptions.length;const font=fontOptions[i];o.font=font;$('fontFamily').value=font;$('fontPreview').textContent=font;$('fontPreview').style.fontFamily='"'+fontForText(o)+'"';draw();const effectiveFont=fontForText(o);if(document.fonts&&document.fonts.load)document.fonts.load(`64px "${effectiveFont}"`).then(()=>document.fonts.ready).then(()=>{if(objects.includes(o)&&o.font===font)draw()}).catch(()=>draw());} $('fontPrev').onclick=()=>chooseFont(-1);$('fontNext').onclick=()=>chooseFont(1);$('fontFamily').onchange=e=>{const font=e.target.value;const o=objects[selected];if(o&&o.type==='text')o.font=font;$('fontPreview').textContent=font;const effectiveFont=o?fontForText(o):font;$('fontPreview').style.fontFamily='"'+effectiveFont+'"';draw();if(document.fonts&&document.fonts.load)document.fonts.load(`64px "${effectiveFont}"`).then(()=>document.fonts.ready).then(()=>draw()).catch(()=>draw());};$('fontSize').oninput=e=>{const o=objects[selected];if(o&&o.type==='text'){o.size=Math.max(8,Math.min(400,+e.target.value||8))/Math.max(.01,o.scale);draw()}};$('btnBold').onclick=()=>{const o=objects[selected];if(o?.type==='text'){o.bold=!o.bold;render()}};$('btnItalic').onclick=()=>{const o=objects[selected];if(o?.type==='text'){o.italic=!o.italic;render()}};$('btnUpper').onclick=()=>{const o=objects[selected];if(o?.type==='text'){o.upper=!o.upper;render()}};$('textPalette').onclick=e=>{const s=e.target.closest('.swatch');if(s)updateSelectedText('color',s.dataset.color);render()};$('strokePalette').onclick=e=>{const sw=e.target.closest('.swatch');if(sw){updateSelectedText('strokeColor',sw.dataset.color);render()}};$('strokeWidth').oninput=e=>{const v=+e.target.value