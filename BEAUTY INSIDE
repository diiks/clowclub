function render(){draw();const hasPhoto=!!photo;$('emptyState').classList.toggle('hidden',hasPhoto);cv.classList.toggle('hidden',!hasPhoto);$('addTextFloatingBtn').classList.toggle('hidden',!hasPhoto);const sel=objects[selected];if(sel&&sel.type==='text'){$('textProperties').classList.remove('hidden');$('objOpacity').value=sel.opacity;$('valOpacity').textContent=sel.opacity;$('fontFamily').value=sel.font;$('fontPreview').textContent=sel.font;$('fontPreview').style.fontFamily='\"'+sel.font+'\"';$('fontSize').value=Math.round(sel.size*sel.scale);$('btnBold').classList.toggle('active',sel.bold);$('btnItalic').classList.toggle('active',sel.italic);$('btnUpper').classList.toggle('active',sel.upper);$('strokeWidth').value=sel.strokeWidth||0;$('strokeWidthValue').textContent=sel.strokeWidth||0;$('shadowIntensity').value=sel.shadowIntensity||0;$('shadowIntensityValue').textContent=(sel.shadowIntensity||0)+'%';$('toggleTextShadow').classList.toggle('active',!!sel.shadowEnabled);$('toggleTextShadow').textContent=sel.shadowEnabled?'✓ Тень включена':'＋ Добавить тень';$('shadowStatus').textContent=sel.shadowEnabled?'Включена':'Выключена';document.querySelectorAll('#textPalette .swatch').forEach(s=>s.classList.toggle('active',s.dataset.color===sel.color));document.querySelectorAll('#strokePalette .swatch').forEach(s=>s.classList.toggle('active',s.dataset.color===(sel.strokeColor||'#171717')))}else $('textProperties').classList.add('hidden')}
