function renderStickers(){const emojis=['✨','🌸','💗','🤍','🦋','⭐','☁️','🌷','🍒','🎀','♡','✦','✿','☀️','🌙','💫','🪞','💎','🕊️','🍓','🌿','🧸','🫧','♥'],grid=$('stickerGrid');grid.innerHTML='';emojis.forEach(e=>{const btn=document.createElement('div');btn.className='control-card';btn.style.minWidth='60px';btn.innerHTML=`<span class="icon" style="font-size:30px">${e}</span>`;btn.onclick=()=>{if(!photo)return alert('Сначала загрузите фото');snap();objects.push({type:'text',text:e,sticker:true,x:cv.width/2,y:cv.height/2,font:'Arial',size:100,color:'#ffffff',bold:false,italic:false,upper:false,rotation:0,scale:1,opacity:100,hidden:false});selected=objects.length-1;render()};grid.appendChild(btn)})}
