ctx.globalCompositeOperation='multiply';ctx.globalAlpha=.28*strength;const shadows=ctx.createLinearGradient(0,0,cv.width,cv.height);shadows.addColorStop(0,'#183d65');shadows.addColorStop(.48,'#28556b');shadows.addColorStop(1,'#101f42');ctx.fillStyle=shadows;ctx.fillRect(0,0,cv.width,cv.height);
